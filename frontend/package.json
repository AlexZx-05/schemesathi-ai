  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/vite/bin/vite.js . --config vite.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
