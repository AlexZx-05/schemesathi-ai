# Local frontend API URL. The browser uses this URL directly.
VITE_API_BASE_URL=http://localhost:8000

# Google web client ID. Use the same public client ID for the API audience
# and browser sign-in; never put a Google client secret in this file.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Comma-separated browser origins permitted by the API.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8080

# Used by Docker Compose. Set both values to private local credentials.
DATABASE_URL=
AUTH_COOKIE_SECURE=false
GROQ_API_KEY=
ENVIRONMENT=development
EMAIL_PROVIDER=development
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Phase 7 knowledge indexing. Only configure reviewed official domains here.
OFFICIAL_SOURCE_ALLOWLIST=
EMBEDDING_PROVIDER=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
KNOWLEDGE_MAX_AGE_DAYS=365

# Phase 8 assistant. Keep these values server-side only.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SECONDS=20

# PostgreSQL development container
POSTGRES_DB=schemesathi
POSTGRES_USER=schemesathi
POSTGRES_PASSWORD=
